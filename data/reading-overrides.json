{
  "001-1": {
    "text": "學而時習之，不亦說乎？",
    "parts": [
      "學而時習之，",
      "不亦悅乎？"
    ],
    "gaps_ms": [
      420
    ],
    "note": "說通悅，僅合成文字引導讀音，展示原文不變。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=9168&la=0&powerMode=0"
  },
  "008-1": {
    "text": "長風破浪會有時，直掛雲帆濟滄海。",
    "parts": [
      "長風破浪，",
      "會有時，",
      "直掛雲帆，",
      "濟滄海。"
    ],
    "gaps_ms": [
      220,
      420,
      220
    ],
    "note": "沿用使用者選定的男聲試聽分組。"
  },
  "018-5": {
    "text": "君子之道，辟如行遠必自邇，辟如登高必自卑",
    "parts": [
      "君子之道，",
      "譬如行遠必自邇，",
      "譬如登高必自卑"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "「辟如」的辟通「譬」，讀 ㄆㄧˋ；此句兩處均為比喻用法。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=408"
  },
  "020-4": {
    "text": "士窮乃見節義。",
    "parts": [
      "士窮乃現節義。"
    ],
    "gaps_ms": [],
    "note": "「見」意為顯露節義，同「現」，讀 ㄒㄧㄢˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=5810"
  },
  "028-5": {
    "text": "君子義以為質，禮以行之，孫以出之，信以成之",
    "parts": [
      "君子義以為質，",
      "禮以行之，",
      "遜以出之，",
      "信以成之"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「孫」表謙卑恭順，讀 ㄒㄩㄣˋ；用「遜」引導，不更改展示文字。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7460"
  },
  "033-2": {
    "text": "讀書百遍，其義自見。",
    "parts": [
      "讀書百遍，",
      "其義自現。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「見」意為文義自行顯現，同「現」，讀 ㄒㄧㄢˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=5810"
  },
  "046-5": {
    "text": "成己，仁也；成物，知也",
    "parts": [
      "成己，",
      "仁也；",
      "成物，",
      "智也"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「成物，知也」與仁相對，指智慧之德；依「知」同「智」義讀 ㄓˋ。此處為語境判讀。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "055-3": {
    "text": "君子博學而日參省乎己，則知明而行無過矣。",
    "parts": [
      "君子博學而日參省乎己，",
      "則智明而行無過矣。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「知明」指智慧明達，知同「智」，讀 ㄓˋ；「參省」仍保留原字，需另依教材讀法驗聽。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "059-1": {
    "text": "知者不惑，仁者不憂，勇者不懼。",
    "parts": [
      "智者不惑，",
      "仁者不憂，",
      "勇者不懼。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "教育部「知者不惑」詞條直接標注 ㄓˋ ㄓㄜˇ ㄅㄨˋ ㄏㄨㄛˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=114426"
  },
  "061-5": {
    "text": "日知其所亡，月無忘其所能。",
    "parts": [
      "日知其所無，",
      "月無忘其所能。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「亡」意為尚未具有的學問，同「無」，讀 ㄨˊ；不可套用到死亡、逃亡等「亡」。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=11548"
  },
  "065-2": {
    "text": "莫春者，春服既成，冠者五六人，童子六七人，浴乎沂，風乎舞雩，詠而歸。",
    "parts": [
      "暮春者，",
      "春服既成，",
      "冠者五六人，",
      "童子六七人，",
      "浴乎沂，",
      "風乎舞雩，",
      "詠而歸。"
    ],
    "gaps_ms": [
      420,
      420,
      420,
      420,
      420,
      420
    ],
    "note": "「莫春」通「暮春」，教育部「莫」詞條直接引用此句，讀 ㄇㄨˋ。「風乎舞雩」另需驗聽吹風義 ㄈㄥˋ，未在本筆覆寫。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=1085"
  },
  "094-2": {
    "text": "一貧一富，乃知交態；一貴一賤，交情乃見。",
    "parts": [
      "一貧一富，",
      "乃知交態；",
      "一貴一賤，",
      "交情乃現。"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「交情乃見」指交情顯現，見同「現」，讀 ㄒㄧㄢˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=5810"
  },
  "112-1": {
    "text": "人生不相見，動如參與商。",
    "parts": [
      "人生不相見，",
      "動如申與商。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "此處「參」是星宿名，教育部「參商」讀 ㄕㄣ ㄕㄤ；以同音「申」引導，避免誤分詞為「參與」。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=131335"
  },
  "131-2": {
    "text": "妻子好合，如鼓瑟琴；兄弟既翕，和樂且湛。",
    "parts": [
      "妻子好合，",
      "如鼓瑟琴；",
      "兄弟既翕，",
      "和樂且丹。"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「湛」在和樂語境表示快樂，教育部明列 ㄉㄢ 並引用「和樂且湛」；僅以「丹」引導該字。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=2007"
  },
  "167-1": {
    "text": "客從遠方來，遺我雙鯉魚。呼兒烹鯉魚，中有尺素書。",
    "parts": [
      "客從遠方來，",
      "衛我雙鯉魚。",
      "呼兒烹鯉魚，",
      "中有尺素書。"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「遺」在「遺我雙鯉魚」意為贈送，讀 ㄨㄟˋ；以單音字「衛」引導，不把其他「遺」全域替換。",
    "source": "https://pedia.cloud.edu.tw/Entry/Detail/?title=%E9%81%BA"
  },
  "168-5": {
    "text": "采采卷耳，不盈頃筐。嗟我懷人，寘彼周行。",
    "parts": [
      "采采卷耳，",
      "不盈頃筐。",
      "嗟我懷人，",
      "寘彼周航。"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "教育部「周行」大道義讀 ㄓㄡ ㄏㄤˊ，且直接引用「寘彼周行」；以「航」引導末字。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=115747"
  },
  "169-4": {
    "text": "愛而不見，搔首踟躕。",
    "parts": [
      "愛而不現，",
      "搔首踟躕。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "此句女子隱藏而不顯現，「見」為顯現義，讀 ㄒㄧㄢˋ；「踟躕」依現有字形讀 ㄔˊ ㄔㄨˊ，不改成「踟躅」。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=5810"
  },
  "182-3": {
    "text": "昔我往矣，楊柳依依；今我來思，雨雪霏霏。",
    "parts": [
      "昔我往矣，",
      "楊柳依依；",
      "今我來思，",
      "玉雪霏霏。"
    ],
    "gaps_ms": [
      420,
      420,
      420
    ],
    "note": "「雨雪」為降雪，雨作動詞讀 ㄩˋ；以「玉」引導，不改「雪」或其他雨字。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=11686"
  },
  "244-3": {
    "text": "獨樂樂不如眾樂樂。",
    "parts": [
      "獨悅樂不如眾悅樂。"
    ],
    "gaps_ms": [],
    "note": "教育部「獨樂樂」讀 ㄉㄨˊ ㄩㄝˋ ㄌㄜˋ；每組前一個樂是音樂，後一個樂是快樂，以「悅樂」引導 ㄩㄝˋ ㄌㄜˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=47432"
  },
  "287-1": {
    "text": "良農不為水旱不耕，良賈不為折閱不市。",
    "parts": [
      "良農不為水旱不耕，",
      "良谷不為折閱不市。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「賈」指商人，讀 ㄍㄨˇ；「良賈」的讀音可由教育部「良賈深藏若虛」詞條核對。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=64874"
  },
  "290-5": {
    "text": "多言數窮，不如守中。",
    "parts": [
      "多言朔窮，",
      "不如守中。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "教育部「多言數窮」直接標注 ㄕㄨㄛˋ；此數為屢次義，以同音「朔」引導。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=47875"
  },
  "296-1": {
    "text": "見利思義，見危授命，久要不忘平生之言。",
    "parts": [
      "見利思義，",
      "見危授命，",
      "久邀不忘平生之言。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "教育部「久要」讀 ㄐㄧㄡˇ ㄧㄠ，指舊約、舊交；以「邀」引導要的一聲。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=92194"
  },
  "317-3": {
    "text": "里仁為美。擇不處仁，焉得知？",
    "parts": [
      "里仁為美。",
      "擇不處仁，",
      "焉得智？"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "教育部「知」智慧義直接引用此句，知同「智」，讀 ㄓˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "319-2": {
    "text": "知之為知之，不知為不知，是知也。",
    "parts": [
      "知之為知之，",
      "不知為不知，",
      "是智也。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "只有末尾「是知也」的知表示智慧，讀 ㄓˋ；前面的知均表示知道，維持 ㄓ，不能整句全換。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "333-1": {
    "text": "人之有德慧術知者，恆存乎疢疾。",
    "parts": [
      "人之有德慧術智者，",
      "恆存乎疢疾。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「德慧術知」的知表示智慧，通「智」，讀 ㄓˋ；這是依詞義作的語境限定判讀。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "336-1": {
    "text": "好學近乎知，力行近乎仁，知恥近乎勇。",
    "parts": [
      "好學近乎智，",
      "力行近乎仁，",
      "知恥近乎勇。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "只有「好學近乎知」的知是智慧之德，讀 ㄓˋ；後面「知恥」仍讀 ㄓ，不替換。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=7499"
  },
  "336-2": {
    "text": "暴虎馮河，死而無悔者，吾不與也；必也臨事而懼，好謀而成者也。",
    "parts": [
      "暴虎憑河，",
      "死而無悔者，",
      "吾不與也；",
      "必也臨事而懼，",
      "好謀而成者也。"
    ],
    "gaps_ms": [
      420,
      420,
      420,
      420
    ],
    "note": "教育部「暴虎馮河」標注 ㄆㄧㄥˊ；以同音「憑」避免讀成姓氏的 ㄈㄥˊ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=16322"
  },
  "342-3": {
    "text": "有為者辟若掘井，掘井九軔而不及泉，猶為棄井也。",
    "parts": [
      "有為者譬若掘井，",
      "掘井九軔而不及泉，",
      "猶為棄井也。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "「辟若」是譬如，辟通「譬」，讀 ㄆㄧˋ；只引導該詞。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=408"
  },
  "343-4": {
    "text": "卒然臨之而不驚，無故加之而不怒。",
    "parts": [
      "猝然臨之而不驚，",
      "無故加之而不怒。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "教育部「卒然」直接引用〈留侯論〉本句，讀 ㄘㄨˋ ㄖㄢˊ；以「猝然」引導，避免讀 ㄗㄨˊ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=142217"
  },
  "347-5": {
    "text": "行拂亂其所為，所以動心忍性，曾益其所不能。",
    "parts": [
      "行拂亂其所為，",
      "所以動心忍性，",
      "增益其所不能。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "教育部「曾益」讀 ㄗㄥ ㄧˋ，並列「增益」異寫；不可把句中曾讀成曾經的 ㄘㄥˊ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=139084"
  },
  "354-3": {
    "text": "時窮節乃見，一一垂丹青。",
    "parts": [
      "時窮節乃現，",
      "一一垂丹青。"
    ],
    "gaps_ms": [
      420
    ],
    "note": "「節乃見」指節操顯現，見同「現」，讀 ㄒㄧㄢˋ。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=5810"
  },
  "355-5": {
    "text": "舜發於畎畝之中，傅說舉於版築之間，膠鬲舉於魚鹽之中。",
    "parts": [
      "舜發於畎畝之中，",
      "傅悅舉於版築之間，",
      "膠鬲舉於魚鹽之中。"
    ],
    "gaps_ms": [
      420,
      420
    ],
    "note": "人名「傅說」教育部標注 ㄈㄨˋ ㄩㄝˋ，以「悅」引導；其他人名未在本筆連帶改寫。",
    "source": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=39474"
  }
}
